# Keep empty to send browser requests through the same-origin Next.js rewrite.
NEXT_PUBLIC_API_BASE_URL=

# Localhost fallback only. Production resolves the Organization from its hostname.
NEXT_PUBLIC_DEVELOPMENT_ORGANIZATION_SLUG=greenzero

# Server-only tenant slug supplied at container runtime.
ORGANIZATION_SLUG=greenzero

# Server-only ASP.NET origin used by next.config.ts.
BACKEND_API_BASE_URL=http://localhost:5154
