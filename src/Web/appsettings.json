{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PayMongo": {
    "BaseUrl": "https://api.paymongo.com/",
    "WebhookToleranceMinutes": 5,
    "PayoutCallbackUrl": "https://localhost:7179/api/webhooks/paymongo/transfers"
  },
  "AdministratorInvitations": {
    "AcceptanceBaseUrl": "https://localhost:4200/admin/invitations/accept",
    "LifetimeHours": 72
  },
  "IdentitySecurity": {
    "PasswordResetBaseUrl": "http://localhost:3000/reset-password"
  },
  "Email": {
    "Smtp": {
      "Port": 587,
      "EnableSsl": true,
      "FromName": "Modular MLM"
    }
  },
  "ObjectStorage": {
    "AzureBlob": {
      "Enabled": false
    }
  },
  "DataProtection": {
    "AzureBlob": {
      "Enabled": false,
      "ApplicationName": "modular-mlm",
      "BlobName": "keys.xml"
    }
  },
  "OrganizationResolution": {
    "Enabled": true,
    "RequireKnownHost": true
  },
  "Idempotency": {
    "CleanupEnabled": true,
    "ClaimMinutes": 5,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 15,
    "CleanupBatchSize": 500,
    "MaximumKeyLength": 200,
    "MaximumOutcomeBytes": 32768
  },
  "Notifications": {
    "Delivery": {
      "Enabled": true,
      "PollSeconds": 5,
      "MaximumAttempts": 8,
      "InitialRetrySeconds": 15,
      "MaximumRetrySeconds": 3600,
      "BatchSize": 50,
      "ClaimSeconds": 120,
      "FromDisplayName": "Modular MLM"
    }
  },
  "Monitoring": {
    "OutboxWarningCount": 100,
    "OutboxUnhealthyCount": 1000,
    "DeadLetterWarningCount": 1
  },
  "BackgroundJobs": {
    "Outbox": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 50,
      "ClaimSeconds": 120,
      "MaximumAttempts": 8,
      "InitialRetrySeconds": 10,
      "MaximumRetrySeconds": 3600,
      "JitterPercentage": 20
    },
    "Durable": {
      "Enabled": true,
      "PollSeconds": 5,
      "BatchSize": 25,
      "ClaimSeconds": 300,
      "MaximumAttempts": 8,
      "InitialRetrySeconds": 30,
      "MaximumRetrySeconds": 3600,
      "DeadLetterAlertThreshold": 1
    },
    "CommissionRelease": {
      "Enabled": true,
      "PollIntervalSeconds": 60,
      "OrganizationBatchSize": 50,
      "CommissionBatchSize": 100,
      "FailureBackoffSeconds": 15
    },
    "AdministratorInvitationExpiry": {
      "Enabled": true,
      "PollIntervalSeconds": 300,
      "OrganizationBatchSize": 50,
      "InvitationBatchSize": 100
    }
  }
}
